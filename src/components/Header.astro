---
import Logo from './Logo.astro';

interface Props {
	// Página en la que está: en el inicio el logo no enlaza a sí mismo, y en /paquetes el enlace
	// a Paquetes queda marcado como página actual.
	actual?: 'inicio' | 'paquetes';
}

const { actual } = Astro.props;
const foco = 'focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-tinta';
const enlace = 'font-serif text-[1.375rem] text-tinta decoration-1 underline-offset-4 sm:text-2xl';
---

<header class="sticky top-0 z-20">
	<!-- Barra blanca con la línea como borde inferior -->
	<div class="bg-blanco">
		<div class="mx-auto max-w-352 px-6 sm:px-10 lg:px-16">
			<div class="flex items-center justify-between gap-6 border-b border-hilo py-6 sm:py-8">
				{
					actual === 'inicio' ? (
						<Logo class="h-11 w-auto text-tinta sm:h-12" />
					) : (
						<a href="/" aria-label="SG Studio, volver al inicio" class={foco}>
							<Logo class="h-11 w-auto text-tinta sm:h-12" />
						</a>
					)
				}
				<div class="flex gap-8">
					<a
						href="/paquetes"
						aria-current={actual === 'paquetes' ? 'page' : undefined}
						class:list={[enlace, foco, actual === 'paquetes' ? 'underline' : 'hover:underline']}
					>
						Paquetes
					</a>
					<!-- Inicio y /paquetes tienen el formulario al final: ahí se baja hasta él sin salir de la
					     página. Desde las páginas legales se va al del inicio. -->
					<a href={actual ? '#contact' : '/#contact'} class:list={[enlace, foco, 'hover:underline']}>Contacto</a>
				</div>
			</div>
		</div>
	</div>
</header>
