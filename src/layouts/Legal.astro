---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<Layout title={`${title} | SG Studio`} description={description}>
	<Header />
	<main class="bg-blanco">
		<article class="legal mx-auto max-w-352 px-6 py-24 sm:px-10 sm:py-32 lg:px-16">
			<slot />
		</article>
	</main>
	<Footer />
</Layout>
